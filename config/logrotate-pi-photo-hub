# Installed to /etc/logrotate.d/pi-photo-hub by scripts/update.sh (on every update).
# Covers update.log only for now; backlog B09 extends this to the other logs.
/var/log/pi-photo-hub/update.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 0644 root root
}

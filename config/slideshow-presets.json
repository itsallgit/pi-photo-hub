{
  "_about": "Slideshow layer settings (B32, R4; redesigned in B41): the defaults, the built-in presets, the classic overlay styles, and the catalog: every choice the clock, the captions and the transitions offer (the API checks settings against it and the phone builds its menus from it). A preset is a starting point: applying it sets these values on top of the defaults; the clock, your own caption layout and which transitions Surprise me leaves out (surpriseSkip) carry over unless the preset has its own. Presets the owner saves live on the Pi in /var/lib/photo-api/presets.json, current values in player.json. Reference: docs/architecture.md, 'Slideshow layer'.",
  "defaults": {
    "autoplay": true,
    "interval": 20,
    "order": "random",
    "chapterLength": 6,
    "bursts": true,
    "recentDays": 14,
    "highlights": true,
    "upright": "fill",
    "motion": "subtle",
    "transition": "fade",
    "surpriseSkip": [],
    "overlay": {
      "date": "relative",
      "place": true,
      "event": false,
      "people": false
    },
    "overlayStyle": 0,
    "overlayMode": "styles",
    "captions": null,
    "titleCards": false,
    "clock": false,
    "clockStyle": {
      "face": "classic",
      "position": "top-left",
      "size": "s",
      "tone": "light",
      "backing": "shadow",
      "opacity": 100,
      "hour12": false,
      "date": false,
      "scrim": "none"
    },
    "night": false,
    "viewer": "layer"
  },
  "presets": {
    "ambient": {
      "label": "Ambient",
      "about": "Background: plays by itself, gentle motion, a small date and place",

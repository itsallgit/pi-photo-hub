        "autoplay": true,
        "interval": 12,
        "order": "chapters",
        "motion": "lively",
        "transition": "zoom",
        "overlay": {
          "date": "relative",
          "place": false,
          "event": true,
          "people": true
        },
        "overlayStyle": 1,
        "titleCards": true,
        "night": false
      }
    },
    "night": {
      "label": "Night",
      "about": "Evening: dimmer and slower, nothing written on screen",
      "settings": {
        "autoplay": true,
        "interval": 40,
        "order": "random",
        "motion": "subtle",
        "transition": "fade",
        "overlay": {
          "date": "off",
          "place": false,
          "event": false,
          "people": false
        },
        "titleCards": false,
        "night": true
